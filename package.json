{
  "name": "carddemo-typescript",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript migration of the CardDemo COBOL credit card application — NestJS + TypeORM + PostgreSQL, runtime: Bun.",
  "type": "module",
  "module": "src/main.ts",
  "scripts": {
    "build": "bun build ./src/main.ts --outdir ./dist --target bun",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "decimal.js": "^10.4.3",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "^1.1.10",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
