%% CardDemo — Program Call Graph
%% Sub-diagram A: CICS Online Program Navigation
%% Color coding: programs=blue, transactions=teal, BMS maps=purple

graph LR
    %% ── CICS Transaction Entry Points ──────────────────────────────
    TX_CC00(["TX: CC00"]):::txn
    TX_CM00(["TX: CM00"]):::txn
    TX_CA00(["TX: CA00"]):::txn
    TX_CB00(["TX: CB00"]):::txn
    TX_CAUP(["TX: CAUP"]):::txn
    TX_CAVW(["TX: CAVW"]):::txn
    TX_CCLI(["TX: CCLI"]):::txn
    TX_CCDL(["TX: CCDL"]):::txn
    TX_CCUP(["TX: CCUP"]):::txn
    TX_CT00(["TX: CT00"]):::txn
    TX_CU00(["TX: CU00"]):::txn
    TX_CR00(["TX: CR00"]):::txn

    %% ── CICS Programs ──────────────────────────────────────────────
    COSGN00C["COSGN00C\nSignon"]:::prog
    COMEN01C["COMEN01C\nMain Menu"]:::prog
    COADM01C["COADM01C\nAdmin Menu"]:::prog
    COBIL00C["COBIL00C\nBill Payment"]:::prog
    COACTVWC["COACTVWC\nAcct View"]:::prog
    COACTUPC["COACTUPC\nAcct Update"]:::prog
    COCRDLIC["COCRDLIC\nCard List"]:::prog
    COCRDSLC["COCRDSLC\nCard Select"]:::prog
    COCRDUPC["COCRDUPC\nCard Update"]:::prog
    COTRN00C["COTRN00C\nTxn List"]:::prog
    COTRN01C["COTRN01C\nTxn View"]:::prog
    COTRN02C["COTRN02C\nTxn Add"]:::prog
    CORPT00C["CORPT00C\nReport Menu"]:::prog
    COUSR00C["COUSR00C\nUser List"]:::prog
    COUSR01C["COUSR01C\nUser View"]:::prog
    COUSR02C["COUSR02C\nUser Add"]:::prog
    COUSR03C["COUSR03C\nUser Del"]:::prog
    COTRTLIC["COTRTLIC\nTxnType List\n[DB2]"]:::variant
    COTRTUPC["COTRTUPC\nTxnType Upd\n[DB2]"]:::variant
    COPAUS0C["COPAUS0C\nAuth Setup\n[IMS]"]:::variant
    CSUTLDTC["CSUTLDTC\nDate Util"]:::util

    %% ── Subprograms ─────────────────────────────────────────────────
    COBDATFT["COBDATFT\n[ASM]"]:::asm
    MVSWAIT["MVSWAIT\n[ASM]"]:::asm
    CEE3ABD["CEE3ABD\n[IBM LE]"]:::ext
    CEEDAYS["CEEDAYS\n[IBM LE]"]:::ext
    CBLTDLI["CBLTDLI\n[IMS]"]:::ext

    %% ── Transaction → Program (INVOKES) ────────────────────────────
    TX_CC00 -->|INVOKES| COSGN00C
    TX_CM00 -->|INVOKES| COMEN01C
    TX_CA00 -->|INVOKES| COADM01C
    TX_CB00 -->|INVOKES| COBIL00C
    TX_CAUP -->|INVOKES| COACTUPC
    TX_CAVW -->|INVOKES| COACTVWC
    TX_CCLI -->|INVOKES| COCRDLIC
    TX_CCDL -->|INVOKES| COCRDSLC
    TX_CCUP -->|INVOKES| COCRDUPC
    TX_CT00 -->|INVOKES| COTRN00C
    TX_CU00 -->|INVOKES| COUSR00C
    TX_CR00 -->|INVOKES| CORPT00C

    %% ── CICS XCTL (program navigation) ─────────────────────────────
    COSGN00C -->|XCTL regular| COMEN01C
    COSGN00C -->|XCTL admin| COADM01C

    COMEN01C -->|XCTL opt1| COACTVWC
    COMEN01C -->|XCTL opt2| COACTUPC
    COMEN01C -->|XCTL opt3| COCRDLIC
    COMEN01C -->|XCTL opt4| COCRDSLC
    COMEN01C -->|XCTL opt5| COCRDUPC
    COMEN01C -->|XCTL opt6| COTRN00C
    COMEN01C -->|XCTL opt7| COTRN01C
    COMEN01C -->|XCTL opt8| COTRN02C
    COMEN01C -->|XCTL opt9| CORPT00C
    COMEN01C -->|XCTL opt10| COBIL00C
    COMEN01C -->|XCTL opt11 if IMS| COPAUS0C

    COADM01C -->|XCTL logout| COSGN00C
    COADM01C -->|XCTL opt1| COUSR00C
    COADM01C -->|XCTL opt2| COUSR01C
    COADM01C -->|XCTL opt3| COUSR02C
    COADM01C -->|XCTL opt4| COUSR03C
    COADM01C -->|XCTL opt5 if DB2| COTRTLIC
    COADM01C -->|XCTL opt6 if DB2| COTRTUPC

    COBIL00C -->|XCTL after pay| COTRN00C

    COACTVWC <-->|XCTL bidirectional| COACTUPC
    COCRDSLC <-->|XCTL bidirectional| COCRDUPC
    COCRDLIC -->|XCTL select| COCRDUPC

    COTRN00C <-->|XCTL bidirectional| COTRN01C
    COTRN00C <-->|XCTL bidirectional| COTRN02C

    COUSR00C -->|XCTL| COUSR01C
    COUSR00C -->|XCTL| COUSR02C
    COUSR00C -->|XCTL| COUSR03C

    COTRTLIC <-->|XCTL bidirectional| COTRTUPC

    %% ── Static CALL ─────────────────────────────────────────────────
    COTRN02C -->|CALL| CSUTLDTC
    CORPT00C -->|CALL| CSUTLDTC
    CSUTLDTC -->|CALL| CEEDAYS
    COPAUS0C -->|CALL| CBLTDLI

    %% ── Styles ───────────────────────────────────────────────────────
    classDef txn   fill:#2ec4b6,stroke:#0a9e93,color:#fff
    classDef prog  fill:#4f87c4,stroke:#2b5f9e,color:#fff
    classDef variant fill:#9b59b6,stroke:#7d3c98,color:#fff
    classDef util  fill:#27ae60,stroke:#1e8449,color:#fff
    classDef asm   fill:#e67e22,stroke:#d35400,color:#fff
    classDef ext   fill:#7f8c8d,stroke:#566573,color:#fff

---

%% Sub-diagram B: Batch Program Call Graph
%% Color coding: programs=blue, batch-utilities=orange, assembler=brown

graph LR
    %% ── JCL Jobs ────────────────────────────────────────────────────
    J_READACCT(["JCL: READACCT"]):::jcl
    J_READCARD(["JCL: READCARD"]):::jcl
    J_READCUST(["JCL: READCUST"]):::jcl
    J_READXREF(["JCL: READXREF"]):::jcl
    J_POSTTRAN(["JCL: POSTTRAN"]):::jcl
    J_INTCALC(["JCL: INTCALC"]):::jcl
    J_TRANREPT(["JCL: TRANREPT"]):::jcl
    J_CREASTMT(["JCL: CREASTMT"]):::jcl
    J_COMBTRAN(["JCL: COMBTRAN"]):::jcl
    J_CBEXPORT(["JCL: CBEXPORT"]):::jcl
    J_CBIMPORT(["JCL: CBIMPORT"]):::jcl
    J_WAITSTEP(["JCL: WAITSTEP"]):::jcl
    J_MNTTRDB2(["JCL: MNTTRDB2"]):::jcl

    %% ── Batch Programs ──────────────────────────────────────────────
    CBACT01C["CBACT01C\nAcct Reader"]:::prog
    CBACT02C["CBACT02C\nCard Reader"]:::prog
    CBACT03C["CBACT03C\nXref Reader"]:::prog
    CBACT04C["CBACT04C\nInterest Calc"]:::prog
    CBCUS01C["CBCUS01C\nCust Reader"]:::prog
    CBEXPORT["CBEXPORT\nData Export"]:::prog
    CBIMPORT["CBIMPORT\nData Import"]:::prog
    CBSTM03A["CBSTM03A\nStatement Gen"]:::prog
    CBTRN01C["CBTRN01C\nTxn Validator"]:::prog
    CBTRN02C["CBTRN02C\nTxn Poster"]:::prog
    CBTRN03C["CBTRN03C\nTxn Reporter"]:::prog
    COBSWAIT["COBSWAIT\nWait Utility"]:::prog
    COBTUPDT["COBTUPDT\nDB2 Updater"]:::variant

    %% ── Subprograms / Utilities ─────────────────────────────────────
    CBSTM03B["CBSTM03B\nFile I/O Sub"]:::util
    COBDATFT["COBDATFT\n[ASM]"]:::asm
    MVSWAIT["MVSWAIT\n[ASM]"]:::asm
    CEE3ABD["CEE3ABD\n[IBM LE]"]:::ext

    %% ── JCL → Program ────────────────────────────────────────────────
    J_READACCT -->|EXEC PGM| CBACT01C
    J_READCARD -->|EXEC PGM| CBACT02C
    J_READCUST -->|EXEC PGM| CBCUS01C
    J_READXREF -->|EXEC PGM| CBACT03C
    J_POSTTRAN -->|EXEC PGM| CBTRN02C
    J_INTCALC  -->|EXEC PGM| CBACT04C
    J_TRANREPT -->|EXEC PGM| CBTRN03C
    J_CREASTMT -->|EXEC PGM| CBSTM03A
    J_CBEXPORT -->|EXEC PGM| CBEXPORT
    J_CBIMPORT -->|EXEC PGM| CBIMPORT
    J_WAITSTEP -->|EXEC PGM| COBSWAIT
    J_MNTTRDB2 -->|EXEC PGM| COBTUPDT

    %% ── CALL ─────────────────────────────────────────────────────────
    CBACT01C  -->|CALL| COBDATFT
    CBACT01C  -->|CALL| CEE3ABD
    CBACT02C  -->|CALL| CEE3ABD
    CBACT03C  -->|CALL| CEE3ABD
    CBACT04C  -->|CALL| CEE3ABD
    CBCUS01C  -->|CALL| CEE3ABD
    CBEXPORT  -->|CALL| CEE3ABD
    CBIMPORT  -->|CALL| CEE3ABD
    CBTRN01C  -->|CALL| CEE3ABD
    CBTRN02C  -->|CALL| CEE3ABD
    CBTRN03C  -->|CALL| CEE3ABD
    COBSWAIT  -->|CALL| MVSWAIT
    CBSTM03A  -->|CALL| CBSTM03B
    CBSTM03A  -->|CALL| CEE3ABD
    COBTUPDT  -->|CALL| CEE3ABD

    %% ── Styles ───────────────────────────────────────────────────────
    classDef jcl     fill:#f39c12,stroke:#d68910,color:#fff
    classDef prog    fill:#4f87c4,stroke:#2b5f9e,color:#fff
    classDef variant fill:#9b59b6,stroke:#7d3c98,color:#fff
    classDef util    fill:#27ae60,stroke:#1e8449,color:#fff
    classDef asm     fill:#e67e22,stroke:#d35400,color:#fff
    classDef ext     fill:#7f8c8d,stroke:#566573,color:#fff

---

%% Sub-diagram C: Key Copybook Dependency Fan-out (top 8 by consumer count)
%% Color coding: copybooks=green, programs=blue

graph LR
    %% ── Hub Copybooks ────────────────────────────────────────────────
    COCOM01Y(["COCOM01Y\nDFHCOMMARE\n26 consumers"]):::cpy
    COTTL01Y(["COTTL01Y\nTitle\n18 consumers"]):::cpy
    CSDAT01Y(["CSDAT01Y\nDate WS\n17 consumers"]):::cpy
    CSUSR01Y(["CSUSR01Y\nUser Ctx\n17 consumers"]):::cpy
    CSMSG01Y(["CSMSG01Y\nMessages\n17 consumers"]):::cpy
    CVACT01Y(["CVACT01Y\nAcct Record\n12 consumers"]):::cpy
    CVACT03Y(["CVACT03Y\nXref Record\n15 consumers"]):::cpy
    CVTRA05Y(["CVTRA05Y\nTxn Record\n10 consumers"]):::cpy

    %% ── Representative Consumers (grouped) ──────────────────────────
    CICS_PROGS["All 17 Core\nCICS Programs"]:::grp
    CICS_VARIANTS["DB2+IMS\nVariants (9)"]:::grp
    BATCH_ACCT["CBACT01C\nCBACT04C\nCBTRN01C\nCBTRN02C"]:::grp
    BATCH_TXN["CBTRN02C\nCBTRN03C\nCOBIL00C"]:::grp

    COCOM01Y -->|COPIES by 17| CICS_PROGS
    COCOM01Y -->|COPIES by 9| CICS_VARIANTS
    COTTL01Y -->|COPIES by 17+| CICS_PROGS
    CSDAT01Y -->|COPIES by 17| CICS_PROGS
    CSUSR01Y -->|COPIES by 17| CICS_PROGS
    CSMSG01Y -->|COPIES by 17| CICS_PROGS
    CVACT01Y -->|COPIES by 4| BATCH_ACCT
    CVACT03Y -->|COPIES by| BATCH_ACCT
    CVTRA05Y -->|COPIES by| BATCH_TXN

    classDef cpy fill:#27ae60,stroke:#1e8449,color:#fff
    classDef grp fill:#4f87c4,stroke:#2b5f9e,color:#fff
